# Local dev .env — committed for convenience (real secrets in prod KMS).
# Override per developer by editing this file. NEVER put real prod keys here.

NODE_ENV=development
PYTHON_ENV=development
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost
# APEX_COOKIE_DOMAIN is left empty so cookies default to the current host

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=languagepro
POSTGRES_USER=languagepro
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://languagepro:changeme@localhost:5432/languagepro

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_LLM_CACHE_DB=1
REDIS_QUEUE_DB=2

# MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_in_prod
S3_REGION=us-east-1
S3_BUCKET_AUDIO=audio-recordings
S3_BUCKET_PROMPTS=audio-prompts
S3_BUCKET_CERTIFICATES=certificates
S3_BUCKET_EXPORTS=exports
S3_USE_SSL=false

# Auth — generate fresh: openssl rand -hex 32
AUTH_JWT_SECRET=dev_jwt_secret_replace_with_openssl_rand_hex_32_chars_minimum
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

S2S_SHARED_SECRET=dev_s2s_secret_replace_with_openssl_rand_hex_32_chars_minimum
S2S_TOKEN_TTL_SECONDS=300

# LLM — set GOOGLE_API_KEY before first generation/scoring call.
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=${GOOGLE_API_KEY}
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

LLM_PROFILE_GENERATE_QUESTION=gemini-2.5-pro:0.7
LLM_PROFILE_GENERATE_QUESTION_FALLBACK=gemini-2.0-pro:0.7
LLM_PROFILE_VALIDATE_QUESTION=gemini-2.5-flash:0.0
LLM_PROFILE_VALIDATE_QUESTION_JURY_2=gemini-2.0-flash:0.0
LLM_PROFILE_VALIDATE_QUESTION_JURY_3=gemini-2.5-pro:0.0
LLM_PROFILE_CLASSIFY_CEFR=gemini-2.5-flash:0.0
LLM_PROFILE_SCORE_WRITING=gemini-2.5-pro:0.0
LLM_PROFILE_SCORE_WRITING_FALLBACK=gemini-2.0-pro:0.0
LLM_PROFILE_SCORE_SPEAKING=gemini-2.5-pro:0.0
LLM_PROFILE_FEEDBACK_UZ=gemini-2.5-pro:0.4
LLM_PROFILE_FEEDBACK_EN=gemini-2.5-pro:0.4
LLM_PROFILE_EMBED=gemini-embedding-001
LLM_EMBED_DIMENSIONS=768
LLM_STT_PROFILE=gemini-2.5-flash:0.0

LLM_CACHE_TTL_SECONDS=86400
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120
LLM_RUNTIME_CONFIG_REFRESH_SECONDS=30

# Internal service URLs
AUTH_API_URL=http://localhost:8002
DATA_ENGINE_API_URL=http://localhost:8000
EXAM_PLATFORM_API_URL=http://localhost:8001

# Prompt registry root — host path in dev; /app/prompts inside Docker.
PROMPTS_DIR=./prompts

# Public URLs (browser-facing)
# Dev mode: APIs run behind Caddy at same-origin /api prefix
NEXT_PUBLIC_AUTH_API=http://app.localhost/api/auth
NEXT_PUBLIC_DATA_API=http://admin.localhost/api/data
NEXT_PUBLIC_EXAM_API=http://app.localhost/api/exam
NEXT_PUBLIC_LANDING_URL=http://localhost
NEXT_PUBLIC_EXAM_WEB_URL=http://app.localhost
NEXT_PUBLIC_ADMIN_WEB_URL=http://admin.localhost

# Observability — leave empty in dev
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LOG_LEVEL=INFO
LOG_FORMAT=console

# Feature flags
FEATURE_REALTIME_SPEAKING=false
FEATURE_PAYMENT=false
FEATURE_CERTIFICATES=true
