# =============================================================================
# LanguagePro AI — Environment Variables
# Copy to `.env` and fill real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
PYTHON_ENV=development
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost
APEX_COOKIE_DOMAIN=.localhost  # production: .aiexam.uz

# -----------------------------------------------------------------------------
# PostgreSQL (single cluster, multiple schemas)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=languagepro
POSTGRES_USER=languagepro
POSTGRES_PASSWORD=change_me_in_prod
DATABASE_URL=postgresql+asyncpg://languagepro:change_me_in_prod@postgres:5432/languagepro

# -----------------------------------------------------------------------------
# Redis (cache + arq queue)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_LLM_CACHE_DB=1
REDIS_QUEUE_DB=2

# -----------------------------------------------------------------------------
# MinIO / S3
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_in_prod
S3_REGION=us-east-1
S3_BUCKET_AUDIO=audio-recordings
S3_BUCKET_PROMPTS=audio-prompts
S3_BUCKET_CERTIFICATES=certificates
S3_BUCKET_EXPORTS=exports
S3_USE_SSL=false

# -----------------------------------------------------------------------------
# Auth (JWT signing, S2S tokens)
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=replace_with_64_byte_hex
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

S2S_SHARED_SECRET=replace_with_64_byte_hex
S2S_TOKEN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# LLM — OpenAI SDK with Google Gemini (via OpenAI-compatible endpoint)
# We use the official `openai` SDK as the single client library, but point it
# at Google's Gemini OpenAI-compat endpoint by default. Any provider exposing
# an OpenAI-compatible API can be swapped in by changing OPENAI_BASE_URL.
# Reference: https://ai.google.dev/gemini-api/docs/openai
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=AIza...
OPENAI_API_KEY=${GOOGLE_API_KEY}
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: separate keys/endpoints per profile (e.g., to run jurors against
# different vendors for true model diversity in validation).
JUROR_2_API_KEY=${GOOGLE_API_KEY}
JUROR_2_BASE_URL=${OPENAI_BASE_URL}
JUROR_3_API_KEY=${GOOGLE_API_KEY}
JUROR_3_BASE_URL=${OPENAI_BASE_URL}

# -----------------------------------------------------------------------------
# LLM dynamic profiles
# Format: model:temperature   (provider implicit — defined by *_BASE_URL)
# Hot-swappable via data_engine.runtime_config (DB) without restart.
# Default model family: Gemini 2.0/2.5 (no ChatGPT models).
# -----------------------------------------------------------------------------
LLM_PROFILE_GENERATE_QUESTION=gemini-2.5-pro:0.7
LLM_PROFILE_GENERATE_QUESTION_FALLBACK=gemini-2.0-pro:0.7

LLM_PROFILE_VALIDATE_QUESTION=gemini-2.5-flash:0.0
LLM_PROFILE_VALIDATE_QUESTION_JURY_2=gemini-2.0-flash:0.0
LLM_PROFILE_VALIDATE_QUESTION_JURY_3=gemini-2.5-pro:0.0

LLM_PROFILE_CLASSIFY_CEFR=gemini-2.5-flash:0.0

LLM_PROFILE_SCORE_WRITING=gemini-2.5-pro:0.0
LLM_PROFILE_SCORE_WRITING_FALLBACK=gemini-2.0-pro:0.0
LLM_PROFILE_SCORE_SPEAKING=gemini-2.5-pro:0.0   # multimodal: audio + transcript

LLM_PROFILE_FEEDBACK_UZ=gemini-2.5-pro:0.4
LLM_PROFILE_FEEDBACK_EN=gemini-2.5-pro:0.4

LLM_PROFILE_EMBED=text-embedding-004           # Gemini embeddings

# Speech-to-text — Gemini 2.5 Flash multimodal handles audio natively
LLM_STT_PROFILE=gemini-2.5-flash:0.0

LLM_CACHE_TTL_SECONDS=86400
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120
LLM_RUNTIME_CONFIG_REFRESH_SECONDS=30

# -----------------------------------------------------------------------------
# Service URLs (internal, docker-compose network)
# -----------------------------------------------------------------------------
AUTH_API_URL=http://auth-api:8000
DATA_ENGINE_API_URL=http://data-engine-api:8000
EXAM_PLATFORM_API_URL=http://exam-platform-api:8000

# Public URLs (browser-facing, same in dev via Caddy)
NEXT_PUBLIC_API_BASE=http://api.localhost
NEXT_PUBLIC_DATA_ENGINE_WEB_URL=http://admin.localhost
NEXT_PUBLIC_EXAM_PLATFORM_URL=http://app.localhost
NEXT_PUBLIC_LANDING_URL=http://localhost

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_REALTIME_SPEAKING=false
FEATURE_PAYMENT=false
FEATURE_CERTIFICATES=true
